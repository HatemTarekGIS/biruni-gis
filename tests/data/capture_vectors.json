{
 "schemas": {
  "building": {
   "biruni_capture": 1,
   "id": "building",
   "rev": 1,
   "title": "Building survey",
   "job": [
    {"name": "job_no", "label": "Job number", "type": "text", "req": true, "keep": false, "title": true}
   ],
   "nodes": [
    {
     "id": "facades",
     "label": "Facades",
     "req": true,
     "nodes": [
      {"id": "front", "label": "Front facade", "req": true, "photos": [1, 3]},
      {"id": "back", "label": "Back facade", "req": true, "photos": [1, 3]}
     ]
    },
    {"id": "roof", "label": "Roof", "req": false, "photos": [1, 4]},
    {
     "id": "floors",
     "label": "Floor",
     "req": true,
     "repeat": {"min": 1, "max": 10},
     "nodes": [
      {
       "id": "apts",
       "label": "Apartment",
       "req": true,
       "repeat": {"min": 1, "max": 10},
       "q": [
        {"name": "apt_no", "label": "Apartment number", "type": "text", "req": true, "keep": false, "title": true},
        {"name": "condition", "label": "Condition", "type": "choice", "req": true, "keep": false, "choices": ["Good", "Fair", "Poor"]}
       ],
       "nodes": [
        {
         "id": "rooms",
         "label": "Room",
         "req": true,
         "repeat": {"min": 1, "max": 10},
         "photos": [2, 6],
         "q": [
          {"name": "room_type", "label": "Room type", "type": "choice", "req": true, "keep": false, "title": true, "choices": ["Kitchen", "Bedroom", "Bathroom"]}
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 },
